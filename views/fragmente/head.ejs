<head>
    <!-- <head>: Secțiunea invizibilă a paginii web unde se definesc metadatele, linkurile către fișiere externe (CSS, JS) și alte resurse necesare. 
         Această secțiune este esențială pentru aspectul, funcționalitatea și indexarea corectă a paginii de către motoarele de căutare. -->

    <meta charset="UTF-8">
    <!-- <meta charset="UTF-8">: Definește setul de caractere utilizat în pagină.
         UTF-8 este standardul modern și permite afișarea corectă a tuturor caracterelor speciale (ex: diacriticele românești). -->

    <meta name="author" content="Echipa Design & Gift">
    <!-- <meta name="author">: Indică autorul paginii, în acest caz "Echipa Design & Gift". 
         Aceste informații pot fi utile pentru indexarea de către motoarele de căutare și pentru detalii despre copyright. -->

    <meta name="keywords" content="cadouri personalizate, globuri de Crăciun, tablouri personalizate, cadouri aniversare, cadouri speciale, promoții pentru sărbători, idei de cadouri unice, produse personalizate, cadouri creative">
    <!-- <meta name="keywords">: Oferă o listă de cuvinte-cheie relevante pentru conținutul paginii.
         Deși motoarele de căutare moderne (precum Google) nu mai pun mare accent pe acest meta-tag, unele încă îl folosesc. -->

    <meta name="description" content="Descoperă cadouri personalizate perfecte pentru Crăciun, aniversări și alte ocazii speciale. Vezi promoțiile pentru globuri de Crăciun, tablouri personalizate și alte cadouri creative.">
    <!-- <meta name="description">: Oferă o descriere a paginii web, care poate apărea în rezultatele motoarelor de căutare.
         Este foarte importantă pentru SEO și trebuie să fie clară și atractivă pentru utilizatori. -->

    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <!-- <meta name="viewport">: Face ca pagina să fie responsivă (adaptabilă pe mobil și desktop).
         width=device-width: Setează lățimea paginii să fie egală cu lățimea ecranului dispozitivului.
         initial-scale=1.0: Păstrează dimensiunea inițială a paginii fără zoom implicit. -->

    <meta name="msapplication-TileColor" content="#A9D08E">
    <meta name="theme-color" content="#A9D08E">
    <!-- Aceste meta-taguri definesc culoarea interfeței pentru browserele și sistemele de operare mobile (ex: bara de adresă pe Android și Windows). -->

    <title>Design & Gift - Cadouri personalizate și promoții</title>
    <!-- <title>: Titlul paginii care apare în tab-ul browserului.
         Este foarte important pentru SEO și trebuie să fie clar și relevant pentru conținutul paginii. -->

    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="/ico/favicon.ico">
    <link rel="icon" type="image/png" sizes="96x96" href="/ico/favicon-96x96.png">
    <link rel="apple-touch-icon" href="/ico/apple-touch-icon.png">
    <link rel="manifest" href="/ico/site.webmanifest">
    <!-- <link rel="icon">: Specifică un favicon (iconița site-ului care apare în tab-ul browserului).
         Se folosesc mai multe formate pentru a asigura compatibilitatea cu diferite dispozitive (ex: desktop, iOS, Android). -->

    <!-- ✅ Corectăm calea către fișierele CSS -->
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="stylesheet" href="/css/promotii.css">
    <link rel="stylesheet" href="/css/menu.css">
    <link rel="stylesheet" href="/css/contact.css">
    <link rel="stylesheet" href="/css/galerie.css">
    <link href="/css/custom.css" rel="stylesheet">
    <!-- <link rel="stylesheet">: Leagă fișierele CSS externe pentru a stiliza pagina web.
         Fiecare fișier CSS conține reguli pentru diferite secțiuni ale paginii (ex: meniu, galerie, promoții). -->

    <!-- Fonturi Google -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;700&display=swap" rel="stylesheet">
    <!-- Aceste linkuri încarcă fonturi externe de pe Google Fonts (în acest caz, fontul "Roboto").
         <link rel="preconnect"> îmbunătățește performanța, permițând browserului să stabilească o conexiune mai rapidă. -->

    <!-- Font Awesome -->
    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.2.0/css/all.min.css"
        integrity="sha512-..."
        crossorigin="anonymous"
        referrerpolicy="no-referrer"
    />
    <!-- Acest link încarcă biblioteca Font Awesome, care oferă o gamă largă de pictograme (ex: iconițe pentru meniuri, butoane etc.).
         integrity="sha512-...": Un hash de securitate pentru a verifica dacă fișierul nu a fost modificat. -->

    <script src="script.js"></script>
    <!-- <script>: Încarcă un fișier JavaScript extern care poate conține funcționalități pentru pagină (ex: meniuri, animații, interacțiuni dinamice). -->
</head>
