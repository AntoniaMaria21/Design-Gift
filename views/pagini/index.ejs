      <!-- Promoții active -->
      <section id="promotii-tabel">
        <!-- <section>: Creează o secțiune dedicată promoțiilor active.
             id="promotii-tabel": Permite identificarea secțiunii pentru stilizare CSS sau interacțiuni JavaScript. -->
    
        <h2>Promoții active</h2>
        <!-- <h2>: Titlu de nivel 2 pentru a marca începutul secțiunii de promoții. -->
    
        <!-- Container pentru scroll pe ecrane mici -->
        <div class="table-container">
            <!-- <div>: Creează un container pentru tabel.
                 class="table-container": Permite aplicarea unui stil CSS pentru a face tabelul responsiv (scroll pe ecrane mici). -->
    
            <table>
                <!-- <table>: Definește un tabel HTML pentru afișarea promoțiilor. -->
    
                <!-- Definim exact 4 coloane în colgroup -->
                <colgroup>
                    <col>
                    <col>
                    <col>
                    <col>
                </colgroup>
                <!-- <colgroup>: Specifică gruparea coloanelor pentru a le aplica stiluri CSS mai ușor.
                     <col>: Reprezintă fiecare coloană din tabel, în acest caz sunt 4 coloane. -->
    
                <!-- Caption poziționat sub tabel (prin CSS) -->
                <caption>Promoțiile sunt valabile până la epuizarea stocului.</caption>
                <!-- <caption>: Adaugă o descriere pentru tabel.
                     Poziționarea sa poate fi ajustată prin CSS (de exemplu, sub tabel). -->
    
                <thead>
                    <!-- <thead>: Definește antetul tabelului, care conține titlurile coloanelor. -->
    
                    <tr>
                        <!-- <tr>: Creează un rând în tabel. -->
                        <th>Produs</th>
                        <th>Reducere</th>
                        <th>Valabilitate</th>
                        <th>Preț redus</th>
                        <!-- <th>: Celule de antet, care sunt afișate cu font bold implicit. -->
                    </tr>
                </thead>
                <!-- Închidere secțiune <thead>. -->
    
                <tbody>
                    <!-- <tbody>: Secțiunea principală a tabelului, unde sunt listate promoțiile. -->
    
                    <tr>
                        <td>Globuri de Crăciun</td>
                        <td>20%</td>
                        <td>1-31 decembrie</td>
                        <td>39 RON</td>
                        <!-- <td>: Celulele individuale care conțin datele pentru fiecare produs. -->
                    </tr>
    
                    <tr>
                        <td>Tablouri personalizate</td>
                        <td>15%</td>
                        <td>10-30 noiembrie</td>
                        <td>85 RON</td>
                    </tr>
    
                    <!-- Celulă cu rowspan -->
                    <tr>
                        <td rowspan="2">Căni personalizate</td>
                        <td>10%</td>
                        <td>5-25 noiembrie</td>
                        <td>25 RON</td>
                    </tr>
                    <!-- <td rowspan="2">: Celula "Căni personalizate" ocupă două rânduri, eliminând nevoia de a repeta produsul. -->
    
                    <tr>
                        <td>15% (comenzi peste 3 buc.)</td>
                        <td>5-25 noiembrie</td>
                        <td>22 RON</td>
                    </tr>
                </tbody>
                <!-- Închidere secțiune <tbody>. -->
    
                <tfoot>
                    <!-- <tfoot>: Creează un rând de subsol al tabelului, utilizat de obicei pentru note sau totaluri. -->
    
                    <tr>
                        <td colspan="4">Toate promoțiile sunt valabile în limita stocului disponibil.</td>
                        <!-- <td colspan="4">: Face ca această celulă să se extindă pe toate cele 4 coloane ale tabelului. -->
                    </tr>
                </tfoot>
                <!-- Închidere secțiune <tfoot>. -->
            </table>
            <!-- Închidere tabel. -->
        </div>
        <!-- Închidere container tabel. -->
    </section>
    <!-- Închidere secțiune "Promoții active". -->
    
      

        
         <!-- Iframe Youtube -->
         <section id="videoclipuri">
          <!-- <section>: Creează o secțiune separată pentru videoclipuri relevante.
               id="videoclipuri": Identificator unic pentru secțiune, util pentru stilizare CSS sau manipulare JavaScript. -->
      
          <h2><b>Videoclipuri relevante</b></h2>
          <!-- <h2>: Titlu principal de nivel 2 care descrie conținutul secțiunii.
               <b>: Îngroașează textul pentru evidențiere. -->
      
          <!-- Wrapper pentru video și linkuri -->
          <div class="video-wrapper">
              <!-- <div>: Creează un container pentru a organiza elementele video și linkurile.
                   class="video-wrapper": Permite aplicarea unui stil CSS personalizat pentru aranjarea conținutului. -->
      
              <div class="video-container">
                  <!-- <div>: Container special pentru videoclip, care ajută la stilizare și responsivitate. -->
      
                  <iframe id="video-frame" 
                      src="https://www.youtube.com/embed/cckwWh5Q1xU" 
                      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
                      allowfullscreen>
                  </iframe>
                  <!-- <iframe>: Creează un cadru încorporat pentru a afișa videoclipuri de pe YouTube.
                       id="video-frame": Atribuie un identificator unic pentru a permite schimbarea dinamică a videoclipului prin JavaScript.
                       src="URL": Specifică linkul către videoclipul YouTube care va fi afișat inițial.
                       allow="...": Permite funcționalități speciale, cum ar fi autoplay, clipboard-write, etc.
                       allowfullscreen: Permite redarea videoclipului pe tot ecranul. -->
              </div>
              <!-- Închidere container video. -->
      
              <!-- Linkurile la dreapta -->
              <div class="video-links">
                  <!-- <div>: Container pentru linkurile care vor schimba videoclipul afișat. -->
      
                  <a href="#" onclick="document.getElementById('video-frame').src='https://www.youtube.com/embed/cckwWh5Q1xU'; return false;">Sistem împachetare</a>
                  <!-- <a>: Creează un link clicabil pentru schimbarea videoclipului.
                       href="#": Folosește un link gol, deoarece acțiunea se va executa prin JavaScript.
                       onclick="...": Modifică atributul `src` al iframe-ului pentru a încărca un nou videoclip. 
                       return false;: Previne comportamentul implicit al linkului (navigarea către altă pagină). -->
      
                  <a href="#" onclick="document.getElementById('video-frame').src='https://www.youtube.com/embed/3xoXzOdM2z4'; return false;">Top 10 cadouri</a>
                  <!-- Link către un alt videoclip YouTube. -->
      
                  <a href="#" onclick="document.getElementById('video-frame').src='https://www.youtube.com/embed/e8FPz9DxXRc'; return false;">Cadouri personalizate Craciun</a>
                  <!-- Link către un alt videoclip YouTube. -->
              </div>
              <!-- Închidere container linkuri video. -->
          </div>
          <!-- Închidere wrapper pentru video și linkuri. -->
      
      </section>
      <!-- Închidere secțiune "Videoclipuri relevante". -->
      

     
        
        
