              >Top 10 cadouri</a
            >
           

            <a
              href="#"
              onclick="document.getElementById('video-frame').src='https://www.youtube.com/embed/e8FPz9DxXRc'; return false;"
              >Cadouri personalizate Craciun</a
            >
           
          </div> -->
       
        </div>
      </section>
      <section id="galerie-imagini">
      <%- include("../fragmente/galerie", {
        cale_galerie: obGalerie.cale_galerie,
        imagini: obGalerie.imagini
    }) %>
    </section>
    
    </main>

    <%- include("../fragmente/footer") %>

    <!-- Buton "Înapoi sus" cu triunghi -->
    <!-- Etapa 2.7 -->
    <a href="#acasa" class="btn-top" data-tooltip="Urcă la începutul paginii">
